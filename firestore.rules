rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dostęp tylko dla dwóch zalogowanych osób – wpisz swoje adresy e-mail
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email in ['ja@example.com', 'maz@example.com'];
    }

    match /items/{itemId} {
      allow read, delete: if isAllowed();
      allow create, update: if isAllowed()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.done is bool
        && (!('order' in request.resource.data) || request.resource.data.order is number);
    }

    // Zapamiętane produkty (podpowiedzi przy wpisywaniu)
    match /products/{productId} {
      allow read, delete: if isAllowed();
      allow create, update: if isAllowed()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.count is number;
    }

    // Karty klienta – screen zapisany jako skompresowany obrazek (data URL)
    match /cards/{cardId} {
      allow read, delete: if isAllowed();
      allow create, update: if isAllowed()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.image is string
        && request.resource.data.image.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.image.size() <= 1000000;
    }
  }
}
